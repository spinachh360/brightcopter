# Optional public contact overrides, not secrets. Leave blank to use shared/contacts.ts.
# Use international digits including the country code, without + or spaces.
VITE_ORDER_WHATSAPP=
VITE_CUSTOMER_CARE_WHATSAPP=
# Preferred: add src/assets/brand-logo.png; it is bundled automatically.
# Optional URL override (public asset or hosted image):
# VITE_BRAND_LOGO_URL=/brand-logo.png
# Public canonical origin; never put passwords or credentials in this URL.
SITE_URL=https://brightcopter.netlify.app
# Private credentials belong ONLY in the server's environment (see .env.server.example).
# VITE_* variables are browser-public; only the three documented public overrides are allowed.
